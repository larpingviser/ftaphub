local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents")
local SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")
local DestroyGrabLine = GrabEvents:WaitForChild("DestroyGrabLine")
local CharacterEvents = ReplicatedStorage:WaitForChild("CharacterEvents")
local Struggle = CharacterEvents:WaitForChild("Struggle")

local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
LocalPlayer.CharacterAdded:Connect(function(c) char = c end)

local function GetHRH(c)
	if not c then return nil end
	return c:FindFirstChild("Head"),
		c:FindFirstChild("HumanoidRootPart"),
		c:FindFirstChild("Humanoid")
end

local function Own(part)
	if not part then return nil end
	SetNetworkOwner:FireServer(part, part.CFrame)
	local owner = part:FindFirstChild("PartOwner")
	if owner and owner.Value == LocalPlayer.Name then return owner end
	return nil
end

local function UnGrab(part)
	if part then DestroyGrabLine:FireServer(part) end
end

local function Teleport(part, cf, offset)
	if part and cf and offset then
		part.CFrame = cf * offset
		part.Velocity = Vector3.zero
		part.RotVelocity = Vector3.zero
	end
end

local activeKicks = {}

local function KickPlayer(target)
	if not target or target == LocalPlayer or activeKicks[target] then return end
	local _, myHRP, myHum = GetHRH(char)
	if not myHRP or not myHum or myHum.Health <= 0 then return end
	local tHead, tHRP, tHum = GetHRH(target.Character)
	if not tHead or not tHRP or not tHum or tHum.Health <= 0 then return end

	activeKicks[target] = true
	task.spawn(function()
		local startCF = myHRP.CFrame
		local now = tick()
		local owned

		while tick() - now < 1 do
			RunService.Heartbeat:Wait()
			Teleport(myHRP, tHRP.CFrame, CFrame.new(0, -8, 0))
			owned = Own(tHead)
			if owned or not tHum.Parent or tHum.Health <= 0 then break end
		end

		Teleport(myHRP, startCF, CFrame.new(0, 0, 0))

		local kickStart = tick()
		while tick() - kickStart < 5 do
			RunService.Heartbeat:Wait()
			if not myHum or myHum.Health <= 0 then break end
			if not tHum or tHum.Health <= 0 then break end
			if not tHead or not tHead.Parent then break end

			Own(tHead)
			Own(tHead)
			if myHum.MoveDirection == Vector3.zero then
				UnGrab(tHead)
			end
			Struggle:FireServer()
		end

		activeKicks[target] = nil
	end)
end

local KickGroup = Tabs.Kick:AddLeftGroupbox("Ownership Kick", "shield")

KickGroup:AddButton({
	Text = "⚡ Kick Everyone",
	Func = function()
		local count = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				KickPlayer(p)
				count += 1
			end
		end
		Library:Notify({
			Title = "Kick",
			Description = "Kicking " .. count .. " players",
			Time = 3,
		})
	end,
})

KickGroup:AddDivider()

KickGroup:AddDropdown("TargetPlayer", {
	SpecialType = "Player",
	ExcludeLocalPlayer = true,
	Text = "Kick Specific Player",
})

KickGroup:AddButton({
	Text = "⚡ Kick Selected",
	Func = function()
		local target = Options.TargetPlayer.Value
		if not target then
			Library:Notify({ Title = "Kick", Description = "No player selected", Time = 3 })
			return
		end
		KickPlayer(target)
	end,
})

KickGroup:AddDivider()

KickGroup:AddToggle("AutoKick", {
	Text = "Auto Kick (instant)",
	Default = false,
})

local autoKickConn
Toggles.AutoKick:OnChanged(function()
	if Toggles.AutoKick.Value then
		autoKickConn = RunService.Heartbeat:Connect(function()
			if not Toggles.AutoKick.Value then return end
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and not activeKicks[p] then
					local _, _, h = GetHRH(p.Character)
					if h and h.Health > 0 then KickPlayer(p) end
				end
			end
		end)
	else
		if autoKickConn then autoKickConn:Disconnect() end
	end
end)

