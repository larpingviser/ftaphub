}

local KEY_FILE = "ftaphub_key.txt"

local function hasSavedKey()
	if isfile and isfile(KEY_FILE) then
		return VALID_KEYS[readfile(KEY_FILE)] == true
	end
	return false
end

local function saveKey(key)
	if writefile then
		writefile(KEY_FILE, key)
	end
end

