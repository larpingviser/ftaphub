-- =========================
--  UNIVERSAL LOADER
-- =========================
local function RunScript(name, url)
	Library:Notify({
		Title = "FTAP HUB",
		Description = "Loading: " .. name,
		Time = 3,
	})

	task.spawn(function()
		loadstring(game:HttpGet(url))()
	end)
end

-- =========================
--  WINDOW
-- =========================
local Window = Library:CreateWindow({
	Title = "FTAP HUB",
	Footer = "v1.0",
	Icon = 95816097006870,
	NotifySide = "Right",
	ShowCustomCursor = true,
})

local Tabs = {
	Scripts = Window:AddTab("Scripts", "code"),
	["UI Settings"] = Window:AddTab("UI Settings", "settings"),
}

-- =========================
--  SCRIPTS TAB
-- =========================
local ScriptsGroup = Tabs.Scripts:AddLeftGroupbox("Available Scripts", "folder")

local names = {}
for name in pairs(Scripts) do table.insert(names, name) end
table.sort(names)

for _, name in ipairs(names) do
	ScriptsGroup:AddButton({
		Text = name,
		Func = function()
			RunScript(name, Scripts[name])
		end,
		Tooltip = "Execute " .. name,
	})
end

ScriptsGroup:AddDivider()

ScriptsGroup:AddButton({
	Text = "▶ Run All",
	Func = function()
		for _, name in ipairs(names) do
			RunScript(name, Scripts[name])
			task.wait(0.5)
		end
	end,
	Tooltip = "Runs every script",
})

-- =========================
--  UI SETTINGS TAB
-- =========================
local MenuGroup = Tabs["UI Settings"]:AddLeftGroupbox("Menu", "wrench")

MenuGroup:AddToggle("KeybindMenuOpen", {
	Default = Library.KeybindFrame.Visible,
	Text = "Open Keybind Menu",
	Callback = function(value)
		Library.KeybindFrame.Visible = value
	end,
})

MenuGroup:AddToggle("ShowCustomCursor", {
	Text = "Custom Cursor",
	Default = true,
	Callback = function(Value)
		Library.ShowCustomCursor = Value
	end,
})

MenuGroup:AddDropdown("NotificationSide", {
	Values = { "Left", "Right" },
	Default = "Right",
	Text = "Notification Side",
	Callback = function(Value)
		Library:SetNotifySide(Value)
	end,
})

MenuGroup:AddDropdown("DPIDropdown", {
	Values = { "50%", "75%", "100%", "125%", "150%", "175%", "200%" },
	Default = "100%",
	Text = "DPI Scale",
	Callback = function(Value)
		Value = Value:gsub("%%", "")
		local DPI = tonumber(Value)
		Library:SetDPIScale(DPI)
	end,
})

MenuGroup:AddDivider()

MenuGroup:AddLabel("Menu bind")
	:AddKeyPicker("MenuKeybind", { Default = "RightShift", NoUI = true, Text = "Menu keybind" })

MenuGroup:AddButton("Unload", function()
	Library:Unload()
end)

Library.ToggleKeybind = Options.MenuKeybind

-- =========================
--  ADDONS
-- =========================
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ "MenuKeybind" })

ThemeManager:SetFolder("FTAPHub")
SaveManager:SetFolder("FTAPHub/specific-game")
SaveManager:SetSubFolder("specific-place")

SaveManager:BuildConfigSection(Tabs["UI Settings"])
ThemeManager:ApplyToTab(Tabs["UI Settings"])

SaveManager:LoadAutoloadConfig()

Library:OnUnload(function()
	print("FTAP HUB unloaded!")
end)
